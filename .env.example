# GitHub Personal Access Token
# Create at https://github.com/settings/tokens
# No scopes required — zero-scope tokens work for public data and raise rate limit to 5000 req/hr
GITHUB_TOKEN=

# Sentry — error monitoring
# DSN found at https://sentry.io/settings/projects/javascript-nextjs/keys/
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Auth token for source map uploads — https://sentry.io/settings/auth-tokens/
SENTRY_AUTH_TOKEN=

# Google AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX)
# Gates the verification loader in src/app/layout.tsx. No ad units ship in this
# repo — this is the site-verification script only.
# Injection surfaces: this file, .env.local, and Vercel project settings
# (Production only). Deliberately NOT set in playwright.config.ts webServer.env:
# the e2e suite asserts the ad-free page, so the gate must stay closed in CI.
NEXT_PUBLIC_ADSENSE_CLIENT=
